.container {
  padding: 24rpx;
  background-color: #f0f2f5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #00b42a;
  padding-left: 12rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #4e5969;
  width: 140rpx;
  flex-shrink: 0;
}

.status-wrap {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.status-off {
  background: #dcdee0;
}

.status-dot.status-on {
  background: #00b42a;
  box-shadow: 0 0 8rpx rgba(0, 180, 42, 0.4);
}

.status-text {
  font-size: 28rpx;
  color: #1d2129;
}

.scan-status {
  font-size: 24rpx;
  color: #ff7d00;
  margin-left: 12rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #f53f3f;
  margin-left: 12rpx;
}

.btn-small {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.btn-mini {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-success {
  background: #00b42a;
  color: #fff;
}

.btn-danger {
  background: #f53f3f;
  color: #fff;
}

.btn-warning {
  background: #ff7d00;
  color: #fff;
}

.picker {
  flex: 1;
}

.picker-value {
  font-size: 28rpx;
  color: #1d2129;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
}

.picker-value.placeholder {
  color: #86909c;
}

.picker-inline {
  font-size: 26rpx;
  color: #07c160;
  padding: 6rpx 12rpx;
  background: #f0f9eb;
  border-radius: 6rpx;
}

.picker-inline-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 140rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.picker-inline-text {
  font-size: 26rpx;
  color: #1d2129;
  font-weight: 500;
}

.picker-arrow {
  font-size: 18rpx;
  color: #86909c;
  margin-left: 8rpx;
}

.area-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.area-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

.area-tools {
  display: flex;
  gap: 12rpx;
}

.area-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.option-label {
  font-size: 26rpx;
  color: #4e5969;
}

.checkbox-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4e5969;
}

.data-area {
  width: 100%;
  height: 300rpx;
  background: #1a1a2e;
  color: #00ff41;
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  white-space: pre-wrap;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.package-item {
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.package-id {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2129;
}

.package-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.package-textarea {
  width: 100%;
  height: 120rpx;
  background: #fff;
  font-size: 26rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.package-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.timer-input {
  width: 120rpx;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  background: #fff;
  border-radius: 6rpx;
  text-align: center;
}

.timer-input-sm {
  width: 80rpx;
  font-size: 22rpx;
  padding: 4rpx 8rpx;
  background: #fff;
  border-radius: 4rpx;
  text-align: center;
}

.picker-inline-sm {
  font-size: 22rpx;
  color: #07c160;
  padding: 4rpx 8rpx;
  background: #f0f9eb;
  border-radius: 4rpx;
}

.btn-package-send {
  flex: 1;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  min-width: 120rpx;
}

.send-textarea {
  width: 100%;
  height: 160rpx;
  background: #1a1a2e;
  color: #00ff41;
  font-family: 'Consolas', 'Monaco', monospace;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.send-main {
  padding-bottom: 16rpx;
}

.send-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.btn-full {
  width: 100%;
  font-size: 30rpx;
  padding: 20rpx;
  border-radius: 8rpx;
}

.package-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.package-options-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 12rpx;
  background: #f5f7fa;
  border-radius: 8rpx;
}

.package-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2129;
}

.package-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.package-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #00b42a;
}

.package-input {
  width: 100%;
  height: 100rpx;
  font-size: 26rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 8rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.scroll-area {
  height: 300rpx;
}

.packages-section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e5e6eb;
}
